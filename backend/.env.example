
# MongoDB connection string for local development
# - For local MongoDB running on your machine use the localhost URI below
# - When running with docker-compose (the service is named `mongo`) use: mongodb://mongo:27017/softflowDB
MONGO_URI=mongodb://127.0.0.1:27017/softflowDB

# Port the backend listens on
PORT=8000

# JWT secret used to sign tokens (replace with a strong secret in production)
JWT_SECRET=change_me_to_a_secure_secret

# NODE_ENV can be 'development' or 'production'
NODE_ENV=development

ADMIN_EMAIL=admin@softflow.local
ADMIN_PASSWORD=AdminPass123!